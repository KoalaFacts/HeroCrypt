#!/bin/sh
# Pre-commit hook to run dotnet format on staged C# files

# Get list of staged .cs files (only added, copied, modified - not deleted/renamed)
STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$' || true)

if [ -z "$STAGED_CS_FILES" ]; then
    # No C# files staged, skip formatting
    exit 0
fi

echo "Running dotnet format on staged C# files..."

# Format each file individually to avoid Roslyn bugs with solution-wide formatting
NEEDS_RESTAGE=0
for file in $STAGED_CS_FILES; do
    if [ -f "$file" ]; then
        # Run dotnet format on individual file using --include
        if ! dotnet format --include "$file" --verify-no-changes --verbosity quiet 2>/dev/null; then
            echo "Formatting: $file"
            dotnet format --include "$file" --verbosity quiet 2>/dev/null || true
            git add "$file"
            NEEDS_RESTAGE=1
        fi
    fi
done

if [ $NEEDS_RESTAGE -eq 1 ]; then
    echo ""
    echo "Files have been formatted and re-staged."
    echo "Please review the changes and commit again."
    exit 1
fi

echo "Code formatting check passed."
exit 0
